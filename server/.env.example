# Copy to .env — never commit a real .env
PORT=5000
# Local MongoDB (Docker or local mongod):
MONGO_URI=mongodb://127.0.0.1:27017/hcm-lite
# OR MongoDB Atlas (no Docker needed) — replace <password> with your database
# user password, URL-encoding special characters (@ -> %40, # -> %23, etc.):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hcm-lite?retryWrites=true&w=majority
# Atlas checklist: Database Access user exists with read/write, Network Access
# allows your IP (0.0.0.0/0 for testing), and the server terminal says
# "MongoDB connected" before you open the frontend.
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o-mini
COMPANY_NAME=HCM Lite
